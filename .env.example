# FalkorDB connection (server-side only)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# Leave empty if the instance has no password
FALKORDB_PASSWORD=
FALKORDB_GRAPH=memoria

# Optional LLM assist (server-side only). Without a key the app runs the
# deterministic policy engine and everything still works.
ANTHROPIC_API_KEY=your-key-here
MEMORIA_LLM_MODEL=claude-opus-5-5
